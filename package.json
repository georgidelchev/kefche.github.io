{
  "name": "kefche",
  "private": true,
  "type": "module",
  "description": "kefche: a multilingual, mobile-first browser games portal.",
  "license": "MIT",
  "packageManager": "pnpm@12.14.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint . --max-warnings=0 --cache",
    "lint:fix": "eslint . --max-warnings=0 --cache --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check:contrast": "node scripts/check-contrast.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.22",
    "@kefche/config": "workspace:*",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "supabase": "2.121.0",
    "typescript": "6.0.3"
  }
}
