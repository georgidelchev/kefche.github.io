# Local Supabase secrets, read by config.toml through env(...).
# Copy to supabase/.env (git-ignored) and fill in. Setup steps: docs/RUNBOOK.md,
# "OAuth providers (local development)". Never commit real values.

# Shared secret for the hourly account-deletion job (docs/RUNBOOK.md, "Account
# deletion job"). Any long random string, e.g. `openssl rand -hex 32`; the same
# value goes into Vault as `purge_accounts_secret`.
PURGE_ACCOUNTS_SECRET=

# Google Cloud console → APIs & Services → Credentials → OAuth client ID (Web application)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Discord Developer Portal → Applications → OAuth2
SUPABASE_AUTH_EXTERNAL_DISCORD_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_DISCORD_SECRET=

# Twitch Developer Console → Applications
SUPABASE_AUTH_EXTERNAL_TWITCH_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_TWITCH_SECRET=

# Meta for Developers → My Apps → Facebook Login
SUPABASE_AUTH_EXTERNAL_FACEBOOK_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_FACEBOOK_SECRET=
