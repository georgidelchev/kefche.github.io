{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    // Language. No DOM here on purpose: engines and the SDK must stay isomorphic
    // (browser, Web Worker, Vitest, Deno). Browser packages add "dom" themselves.
    "target": "es2024",
    "lib": ["es2024"],
    "types": [],

    // Modules (bundled by Vite; type-checked only, never emitted by tsc).
    "module": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,

    // Strictness (SPEC §2).
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnreachableCode": false,
    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true
  }
}
