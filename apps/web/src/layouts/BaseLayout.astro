---
import Fonts, { type Script } from "@/components/Fonts.astro";
import ThemeScript from "@/features/theme/ThemeScript.astro";
import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
  lang: string;
  script?: Script;
}

const { title, description, lang, script = "latin" } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <ThemeScript />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <Fonts script={script} />
  </head>
  <body>
    <slot />
  </body>
</html>
