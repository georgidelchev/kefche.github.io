---
import Fonts from "@/components/Fonts.astro";
import SeoHead from "@/components/SeoHead.astro";
import ThemeScript from "@/features/theme/ThemeScript.astro";
import { LOCALE_INFO, type Locale } from "@/i18n/locales";
import "@/styles/global.css";

interface Props {
  locale: Locale;
  /** Locale-independent path of this page, e.g. "/" (canonical + hreflang). */
  path: string;
  title: string;
  description: string;
  noindex?: boolean;
}

const { locale, path, title, description, noindex } = Astro.props;
const { bcp47, dir, script } = LOCALE_INFO[locale];
---

<!doctype html>
<html lang={bcp47} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <ThemeScript />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <SeoHead
      locale={locale}
      path={path}
      title={title}
      description={description}
      noindex={noindex ?? false}
    />
    <Fonts script={script} />
  </head>
  <body>
    <slot />
  </body>
</html>
