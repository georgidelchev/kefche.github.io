---
import BootScript from "@/components/BootScript.astro";
import Fonts from "@/components/Fonts.astro";
import SeoHead from "@/components/SeoHead.astro";
import { LOCALE_INFO, type Locale } from "@/i18n/locales";
import { getSupabaseEnv } from "@/lib/env";
import "@/styles/global.css";

interface Props {
  locale: Locale;
  /** Locale-independent path of this page, e.g. "/" (canonical + hreflang). */
  path: string;
  title: string;
  description: string;
  noindex?: boolean;
}

const { locale, path, title, description, noindex } = Astro.props;
const { bcp47, dir, script } = LOCALE_INFO[locale];
// Fails the build on invalid Supabase settings before client code inlines them.
getSupabaseEnv();
---

<!doctype html>
<!--
  `group/root` lets components react to root data attributes (data-rail,
  data-theme, data-account).
-->
<html lang={bcp47} dir={dir} class="group/root">
  <head>
    <meta charset="utf-8" />
    <BootScript />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <SeoHead
      locale={locale}
      path={path}
      title={title}
      description={description}
      noindex={noindex ?? false}
    />
    <Fonts script={script} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <slot />
  </body>
</html>
