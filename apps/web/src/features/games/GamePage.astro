---
import { getRelativeLocaleUrl } from "astro:i18n";
import { Clock, Users } from "lucide-react";

import JsonLd from "@/components/JsonLd.astro";
import AppShell from "@/features/shell/AppShell.astro";
import { getT } from "@/i18n/i18n";
import { LOCALE_INFO, type Locale } from "@/i18n/locales";

import { BOT_NAME_KEYS, CATEGORY_KEYS, playablePlayers } from "./catalog";
import { GamePlayer } from "./GamePlayer";

import type { RegisteredGame } from "./registry";
import type { TurnStrings } from "./turn/labels";
import type { TurnConfig, TurnMode } from "./turn/match-setup";

// A game's page (SPEC §15): play first, then the about / how to play /
// controls / tips / FAQ sections with JSON-LD.
interface Props {
  locale: Locale;
  game: RegisteredGame;
}

const { locale, game } = Astro.props;
const t = getT(locale);
const { bcp47, dir } = LOCALE_INFO[locale];
const { manifest } = game;
const text = game.text[locale];
const path = `/games/${manifest.id}/`;
const categoryPath = `/games/${manifest.category}/`;
const categoryName = t(CATEGORY_KEYS[manifest.category].name);
const url = (p: string) => new URL(getRelativeLocaleUrl(locale, p), Astro.site).href;

const players = playablePlayers(manifest);
const facts = [
  {
    Icon: Users,
    label:
      players.min === players.max
        ? t("games:players", { min: players.min })
        : t("games:playersRange", { min: players.min, max: players.max }),
  },
  {
    Icon: Clock,
    label: t("games:minutes", {
      min: manifest.estimatedMinutes[0],
      max: manifest.estimatedMinutes[1],
    }),
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "VideoGame",
    name: text.name,
    description: text.description,
    url: url(path),
    inLanguage: bcp47,
    genre: categoryName,
    gamePlatform: "Web browser",
    applicationCategory: "Game",
    operatingSystem: "Any",
    numberOfPlayers: { "@type": "QuantitativeValue", minValue: players.min, maxValue: players.max },
    offers: { "@type": "Offer", price: 0, priceCurrency: "EUR" },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: t("nav:games"), item: url("/games/") },
      { "@type": "ListItem", position: 2, name: categoryName, item: url(categoryPath) },
      { "@type": "ListItem", position: 3, name: text.name, item: url(path) },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: text.faq.map((f) => ({
      "@type": "Question",
      name: f.question,
      acceptedAnswer: { "@type": "Answer", text: f.answer },
    })),
  },
];

const playerStrings = {
  play: t("games:play"),
  loading: t("games:loading"),
  loadFailed: t("games:loadFailed"),
  retry: t("games:retry"),
  pause: t("games:pause"),
  paused: t("games:paused"),
  resume: t("games:resume"),
  restart: t("games:restart"),
  exit: t("games:exit"),
  mute: t("games:mute"),
  unmute: t("games:unmute"),
  won: t("games:won"),
  gameOver: t("games:gameOver"),
  // Placeholders survive here and are filled by the player.
  score: t("games:score", { score: "{score}" }),
  time: t("games:time", { time: "{time}" }),
  playAgain: t("games:playAgain"),
};
// Turn-based games open a setup screen (seats, bots, timer) instead of starting at once.
const turnModes = manifest.modes.filter((m): m is TurnMode => m === "solo-bots" || m === "hotseat");
const turnConfig: TurnConfig | null =
  manifest.kind === "turn" && turnModes.length > 0
    ? {
        modes: turnModes,
        players: manifest.players,
        difficulties: manifest.bots.supported ? manifest.bots.difficulties : [],
        timers: manifest.timers,
      }
    : null;
const turnStrings: TurnStrings = {
  start: { "solo-bots": t("games:turn.start.soloBots"), hotseat: t("games:turn.start.hotseat") },
  setupTitle: {
    "solo-bots": t("games:turn.setupTitle.soloBots"),
    hotseat: t("games:turn.setupTitle.hotseat"),
  },
  players: t("games:turn.players"),
  player: t("games:turn.player", { n: "{n}" }),
  you: t("games:turn.you"),
  person: t("games:turn.person"),
  bot: t("games:turn.bot"),
  difficulty: t("games:turn.difficulty"),
  difficulties: {
    easy: t("games:turn.difficulties.easy"),
    medium: t("games:turn.difficulties.medium"),
    hard: t("games:turn.difficulties.hard"),
  },
  timer: t("games:turn.timer"),
  timerNone: t("games:turn.timerNone"),
  timerPerMove: t("games:turn.timerPerMove", { seconds: "{seconds}" }),
  timerClock: t("games:turn.timerClock", { minutes: "{minutes}", increment: "{increment}" }),
  begin: t("games:turn.begin"),
  changeSetup: t("games:turn.changeSetup"),
  botBadge: t("games:turn.botBadge", { difficulty: "{difficulty}" }),
  toMove: t("games:turn.toMove", { name: "{name}" }),
  thinking: t("games:turn.thinking", { name: "{name}" }),
  clockLabel: t("games:turn.clockLabel", { name: "{name}", time: "{time}" }),
  wins: t("games:turn.wins", { name: "{name}" }),
  winners: t("games:turn.winners", { names: "{names}" }),
  youWin: t("games:turn.youWin"),
  youLose: t("games:turn.youLose"),
  draw: t("games:turn.draw"),
  outOfTime: t("games:turn.outOfTime", { name: "{name}" }),
  botNames: Object.fromEntries(
    Object.entries(BOT_NAME_KEYS).map(([id, key]) => [id, t(key)]),
  ) as TurnStrings["botNames"],
};
const section = "grid gap-3";
const crumb = "rounded-sm hover:underline";
---

<AppShell
  locale={locale}
  path={path}
  section="games"
  title={t("common:meta.sectionTitle", { section: text.name })}
  description={text.description}
>
  <article class="mx-auto grid w-full max-w-3xl gap-10 pb-6">
    <nav aria-label={t("games:breadcrumb")} class="text-sm text-muted">
      <a href={getRelativeLocaleUrl(locale, "/games/")} class={crumb}>
        {t("nav:games")}
      </a>
      <span aria-hidden="true"> / </span>
      <a href={getRelativeLocaleUrl(locale, categoryPath)} class={crumb}>
        {categoryName}
      </a>
      <span aria-hidden="true"> / </span>
      <span aria-current="page">{text.name}</span>
    </nav>

    <header class="grid gap-4">
      <!-- Decorative: the heading below names the game. -->
      <img
        src={game.art.hero}
        alt=""
        width="1200"
        height="450"
        fetchpriority="high"
        decoding="async"
        class="aspect-[8/3] w-full rounded-2xl"
      />
      <h1 class="text-4xl md:text-5xl">{text.name}</h1>
      <p class="text-lg text-muted">{text.tagline}</p>
      <ul class="flex flex-wrap gap-2">
        {facts.map(({ Icon, label }) => (
          <li class="flex items-center gap-2 rounded-full bg-surface-2 px-3 py-1 text-sm font-semibold">
            <Icon aria-hidden="true" className="size-4" />
            {label}
          </li>
        ))}
      </ul>
      <div>
        <GamePlayer
          client:load
          id={manifest.id}
          name={text.name}
          locale={bcp47}
          dir={dir}
          strings={playerStrings}
          ui={text.ui}
          {...(turnConfig ? { turn: { config: turnConfig, strings: turnStrings } } : {})}
        />
      </div>
    </header>

    <section class={section} aria-labelledby="about">
      <h2 id="about" class="text-2xl">
        {t("games:sections.about", { name: text.name })}
      </h2>
      {text.about.map((p) => (
        <p class="max-w-prose">{p}</p>
      ))}
    </section>
    <section class={section} aria-labelledby="how-to-play">
      <h2 id="how-to-play" class="text-2xl">
        {t("games:sections.howToPlay")}
      </h2>
      <ol class="grid max-w-prose list-decimal gap-2 ps-6">
        {text.howToPlay.map((s) => (
          <li>{s}</li>
        ))}
      </ol>
    </section>
    <section class={section} aria-labelledby="controls">
      <h2 id="controls" class="text-2xl">
        {t("games:sections.controls")}
      </h2>
      <ul class="grid max-w-prose list-disc gap-2 ps-6">
        {text.controls.map((s) => (
          <li>{s}</li>
        ))}
      </ul>
    </section>
    <section class={section} aria-labelledby="tips">
      <h2 id="tips" class="text-2xl">
        {t("games:sections.tips")}
      </h2>
      <ul class="grid max-w-prose list-disc gap-2 ps-6">
        {text.tips.map((s) => (
          <li>{s}</li>
        ))}
      </ul>
    </section>
    <section class={section} aria-labelledby="faq">
      <h2 id="faq" class="text-2xl">
        {t("games:sections.faq")}
      </h2>
      <dl class="grid max-w-prose gap-4">
        {text.faq.map((f) => (
          <div class="grid gap-1">
            <dt class="font-semibold">{f.question}</dt>
            <dd class="text-muted">{f.answer}</dd>
          </div>
        ))}
      </dl>
    </section>
  </article>
  <JsonLd data={jsonLd} />
</AppShell>
