---
import { BookOpen } from "lucide-react";

import { getT } from "@/i18n/i18n";
import type { Locale } from "@/i18n/locales";

// Word of the Day (SPEC §12.7), scaffolding only (Phase 7 Q3): the words for
// each language come with the content packs (Phase 15). The card stays
// hidden until today has a word in the page's language (word-card.client.ts).
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getT(locale);
---

<section
  hidden
  class="grid gap-2 rounded-2xl border border-border bg-surface p-4 md:p-6"
  aria-labelledby="word-heading"
  data-word
  data-locale={locale}
>
  <h2 id="word-heading" class="flex items-center gap-2 text-2xl">
    <BookOpen aria-hidden="true" className="size-6" />
    {t("common:wordOfTheDay.title")}
  </h2>
  <p class="text-2xl font-semibold" data-word-text></p>
  <p class="text-muted empty:hidden" data-word-meaning></p>
</section>

<script>
  import "@/features/daily/word-card.client";
</script>
