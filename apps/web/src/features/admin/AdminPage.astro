---
import { getRelativeLocaleUrl } from "astro:i18n";

import { authPaths } from "@/features/auth/paths";
import AppShell from "@/features/shell/AppShell.astro";
import { getT } from "@/i18n/i18n";
import { DEFAULT_LOCALE, LOCALE_INFO, type Locale } from "@/i18n/locales";
import { getArenaUrl } from "@/lib/env";

import { AdminPanel } from "./AdminPanel";
import { ADMIN_SECTIONS, type AdminSectionId } from "./sections";
import { adminStrings, adminView } from "./strings";

// One admin page (src/pages/[locale]/admin/): private, noindex and the same
// for everyone; the island fills it for staff only.
interface Props {
  locale: Locale;
  section: AdminSectionId;
}

const { locale, section } = Astro.props;
const t = getT(locale);
const strings = adminStrings(t);
const paths = authPaths(locale, getRelativeLocaleUrl);
const path = ADMIN_SECTIONS.find((s) => s.id === section)?.path ?? "/admin/";
const links = Object.fromEntries(
  ADMIN_SECTIONS.map((s) => [s.id, getRelativeLocaleUrl(locale, s.path)]),
) as Record<AdminSectionId, string>;
const adminPaths = {
  profileBase: getRelativeLocaleUrl(locale, "/u/"),
  audit: links.audit,
  users: links.users,
  reports: links.reports,
  chat: links.chat,
  games: links.games,
  integrity: links.integrity,
  i18n: links.i18n,
  i18nReport: `${getRelativeLocaleUrl(DEFAULT_LOCALE, "/admin/")}i18n-report.json`,
  arena: getArenaUrl(),
};
---

<AppShell
  locale={locale}
  path={path}
  title={t("common:meta.sectionTitle", {
    section: t("admin:pageTitle", { section: strings.sections[section] }),
  })}
  description={t("admin:description")}
  noindex
>
  <div class="grid w-full gap-6 pb-6">
    <AdminPanel
      client:load
      view={adminView(section, t, locale)}
      strings={strings}
      bcp47={LOCALE_INFO[locale].bcp47}
      paths={adminPaths}
      links={links}
      signInPath={paths.signIn}
      homePath={paths.home}
    />
  </div>
</AppShell>
