---
import { Megaphone } from "lucide-react";

import { getT } from "@/i18n/i18n";
import type { Locale } from "@/i18n/locales";

// The news ticker (SPEC §14, Phase 10 step 8): announcements an admin marked
// for it, newest first, in the page's language (English when it's missing).
// Hidden until there's one (news-ticker.client.ts); a plain list, so it
// doesn't move on its own.
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getT(locale);
---

<aside
  hidden
  aria-labelledby="news-heading"
  class="grid gap-2 rounded-2xl border border-border bg-surface p-4"
  data-news
  data-locale={locale}
>
  <h2 id="news-heading" class="flex items-center gap-2 text-lg">
    <Megaphone aria-hidden="true" className="size-5" />
    {t("common:news.title")}
  </h2>
  <ul class="grid gap-1" data-news-list></ul>
</aside>

<script>
  import "@/features/news/news-ticker.client";
</script>
