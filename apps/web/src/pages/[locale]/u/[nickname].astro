---
import { getRelativeLocaleUrl } from "astro:i18n";
import { CloudOff } from "lucide-react";

import { levelProgress } from "@kefche/game-sdk";
import { UserAvatar } from "@kefche/ui/components/avatar";
import { isAvatarFrame } from "@kefche/ui/lib/frames";

import { avatarUrl } from "@/features/account/avatar-url";
import NotFoundPage from "@/features/errors/NotFoundPage.astro";
import ProfileActions from "@/features/friends/ProfileActions.astro";
import { friendsStrings } from "@/features/friends/strings";
import { gameName, gameNames, roomGames } from "@/features/games/game-names";
import AchievementCard from "@/features/profile/AchievementCard.astro";
import { shownAchievements } from "@/features/profile/achievements";
import { fetchPlayerHistory, PROVISIONAL_GAMES } from "@/features/profile/history";
import {
  clockText,
  durationText,
  outcomeOf,
  outcomeText,
  playerName,
  playTimeText,
  poolName,
  ratingChange,
  scoreText,
} from "@/features/profile/history-text";
import { fetchPublicProfile } from "@/features/profile/public-profile";
import RatingHistoryChart from "@/features/profile/RatingHistoryChart.astro";
import AppShell from "@/features/shell/AppShell.astro";
import { getT } from "@/i18n/i18n";
import { DEFAULT_LOCALE, isLocale, LOCALE_INFO } from "@/i18n/locales";
import { getSupabaseEnv } from "@/lib/env";

// Public profile (SPEC §7.2), rendered in the Worker on request so shared
// links get a real title and preview. Public fields only. noindex: players
// are 13+, so profiles stay out of search engines; links still preview.
// Ratings, stats and recent games are public (owner decision 2026-10-24,
// and the privacy notice since Phase 7). A signed-in viewer also gets friend
// actions and mutual friends, filled in by the browser (ProfileActions).
export const prerender = false;

const env = getSupabaseEnv();
const locale = isLocale(Astro.params.locale) ? Astro.params.locale : DEFAULT_LOCALE;
const lookup =
  env && isLocale(Astro.params.locale)
    ? await fetchPublicProfile(env, Astro.params.nickname ?? "")
    : ({ status: "missing" } as const);

if (lookup.status === "found" && lookup.profile.nickname !== Astro.params.nickname) {
  // One canonical URL per profile: the nickname as its owner spells it.
  return Astro.redirect(
    getRelativeLocaleUrl(locale, `/u/${encodeURIComponent(lookup.profile.nickname)}/`),
    301,
  );
}

if (lookup.status === "found") {
  Astro.response.headers.set("Cache-Control", "public, max-age=60");
} else if (lookup.status === "missing") {
  Astro.response.status = 404;
  Astro.response.headers.set("Cache-Control", "public, max-age=30");
} else {
  Astro.response.status = 503;
  Astro.response.headers.set("Cache-Control", "no-store");
}

const t = getT(locale);
const { bcp47 } = LOCALE_INFO[locale];
const profile = lookup.status === "found" ? lookup.profile : null;
const image = profile && env ? avatarUrl(profile, env.PUBLIC_SUPABASE_URL) : null;
// The profile shows without its history if that can't be read.
const history = profile && env ? await fetchPlayerHistory(env, profile.id) : null;
const number = (n: number) => Math.round(n).toLocaleString(bcp47);
const date = new Intl.DateTimeFormat(bcp47, { dateStyle: "medium" });
const games = (history?.matches ?? []).map((match) => {
  const me = match.players.find((p) => p.seat === match.seat);
  const opponent = match.players.find((p) => p.seat !== match.seat);
  const outcome = me?.outcome === null || me === undefined ? null : outcomeOf(me.outcome);
  const game = gameName(match.gameId, locale);
  return {
    id: match.id,
    outcome,
    // A game alone, or a race (each racer's own match), has a score or a time instead.
    badge: outcome ? outcomeText(t, outcome) : me ? scoreText(t, me, bcp47) : null,
    title: opponent
      ? t("profile:versus", {
          name: playerName(t, opponent, match.rated ? undefined : { bcp47 }),
        })
      : game,
    detail: [
      opponent ? game : "",
      clockText(t, match.timer, match.pool, bcp47),
      date.format(new Date(match.endedAt)),
    ]
      .filter(Boolean)
      .join(" · "),
    change: me ? ratingChange(me, bcp47) : null,
    href: getRelativeLocaleUrl(locale, `/matches/${match.id}/`),
  };
});
const totals = history?.totals
  ? [
      { label: t("profile:stats.matches"), value: number(history.totals.matches) },
      {
        label: t("profile:stats.timePlayed"),
        value: playTimeText(history.totals.timePlayedMs, bcp47),
      },
      { label: t("profile:stats.gamesTried"), value: number(history.totals.gamesTried) },
      ...(history.totals.favoriteGame
        ? [
            {
              label: t("profile:stats.favorite"),
              value: gameName(history.totals.favoriteGame, locale),
            },
          ]
        : []),
    ]
  : [];
// Each game shows the figures it has: a win and a loss for games against
// someone, a score or a time for games alone.
const gameStats = (history?.stats ?? []).map((s) => {
  const decided = s.wins + s.losses + s.draws > 0;
  return {
    name: gameName(s.gameId, locale),
    facts: [
      { label: t("profile:stats.played"), value: number(s.played) },
      ...(decided
        ? [
            { label: t("profile:stats.wins"), value: number(s.wins) },
            { label: t("profile:stats.losses"), value: number(s.losses) },
            { label: t("profile:stats.draws"), value: number(s.draws) },
            { label: t("profile:stats.bestStreak"), value: number(s.bestStreak) },
          ]
        : []),
      ...(s.bestScore === null
        ? []
        : [{ label: t("profile:stats.bestScore"), value: number(s.bestScore) }]),
      ...(s.averageScore === null
        ? []
        : [{ label: t("profile:stats.averageScore"), value: number(s.averageScore) }]),
      ...(s.bestTimeMs === null
        ? []
        : [{ label: t("profile:stats.bestTime"), value: durationText(s.bestTimeMs) }]),
      { label: t("profile:stats.timePlayed"), value: playTimeText(s.timePlayedMs, bcp47) },
      ...(s.lastPlayedAt
        ? [{ label: t("profile:stats.lastPlayed"), value: date.format(new Date(s.lastPlayedAt)) }]
        : []),
    ],
  };
});
const achievements = shownAchievements(history?.achievements ?? [], t, locale, bcp47);
// The showcase, in its order (SPEC §12.6: up to 3).
const showcase = achievements
  .filter((a) => a.pinned !== null)
  .sort((a, b) => (a.pinned ?? 0) - (b.pinned ?? 0));
const chartStrings = {
  summary: (from: string, to: string) => t("profile:chart.summary", { from, to }),
  table: t("profile:chart.table"),
  date: t("profile:chart.date"),
  rating: t("profile:chart.rating"),
};
const OUTCOME_CLASS = {
  win: "bg-success text-on-success",
  loss: "bg-danger text-on-danger",
  draw: "bg-surface-2",
} as const;
const level = profile ? levelProgress(profile.xp) : null;
const facts = profile
  ? [
      {
        label: t("profile:joined"),
        value: new Intl.DateTimeFormat(bcp47, { year: "numeric", month: "long" }).format(
          new Date(profile.created_at),
        ),
      },
      ...(profile.country
        ? [
            {
              label: t("profile:country"),
              value:
                new Intl.DisplayNames([bcp47], { type: "region" }).of(profile.country) ??
                profile.country,
            },
          ]
        : []),
    ]
  : [];
---

{lookup.status === "missing" && <NotFoundPage locale={locale} />}

{lookup.status === "error" && (
  <AppShell
    locale={locale}
    path={`/u/${encodeURIComponent(Astro.params.nickname ?? "")}/`}
    title={t("common:meta.sectionTitle", { section: t("nav:profile") })}
    description={t("profile:unavailable")}
    noindex
  >
    <section class="mx-auto grid max-w-xl justify-items-center gap-4 py-12 text-center">
      <CloudOff aria-hidden="true" className="size-12 text-muted" />
      <p role="alert" class="text-lg">
        {t("profile:unavailable")}
      </p>
    </section>
  </AppShell>
)}

{profile && (
  <AppShell
    locale={locale}
    path={`/u/${encodeURIComponent(profile.nickname)}/`}
    title={t("common:meta.sectionTitle", { section: profile.nickname })}
    description={t("profile:description", { nickname: profile.nickname })}
    noindex
  >
    <article class="mx-auto grid w-full max-w-2xl gap-6 py-6 md:py-12">
      <header class="flex flex-col items-center gap-4 text-center sm:flex-row sm:text-start">
        <UserAvatar
          name={profile.nickname}
          id={profile.id}
          size="xl"
          {...(image ? { src: image } : {})}
          frame={isAvatarFrame(profile.avatar_frame) ? profile.avatar_frame : null}
        />
        <div class="grid min-w-0 justify-items-center gap-1 sm:justify-items-start">
          <h1 class="min-w-0 text-3xl break-words md:text-4xl">{profile.nickname}</h1>
          <p
            hidden
            data-presence
            data-user-id={profile.id}
            data-strings={JSON.stringify(friendsStrings(t).presence)}
            data-games={JSON.stringify(gameNames(locale))}
            class="flex items-center gap-1.5 font-semibold"
          >
            <span
              aria-hidden="true"
              data-presence-dot
              class="size-2.5 rounded-full bg-success"
            ></span>
            <span data-presence-text></span>
          </p>
        </div>
      </header>
      <ProfileActions
        t={t}
        userId={profile.id}
        nickname={profile.nickname}
        profileBase={getRelativeLocaleUrl(locale, "/u/")}
        bcp47={bcp47}
        games={roomGames(locale)}
        playBase={getRelativeLocaleUrl(locale, "/play/")}
        messagesPath={getRelativeLocaleUrl(locale, "/messages/")}
        guidelinesPath={getRelativeLocaleUrl(locale, "/guidelines/")}
        avatarPath={profile.avatar_kind === "upload" ? profile.avatar_path : null}
      />
      <dl class="grid grid-cols-2 gap-3 sm:grid-cols-3">
        {level && (
          <div class="col-span-2 grid gap-2 rounded-2xl border border-border bg-surface p-4 sm:col-span-1">
            <dt class="text-sm text-muted">{t("profile:level")}</dt>
            <dd class="grid gap-2">
              <span class="text-lg font-semibold">{number(level.level)}</span>
              <span aria-hidden="true" class="h-2 overflow-hidden rounded-full bg-surface-2">
                <span
                  class="block h-full rounded-full bg-brand-strong"
                  style={{ width: `${String(Math.round(level.fraction * 100))}%` }}
                />
              </span>
              <span class="text-sm text-muted">
                {t("profile:xpToNext", {
                  into: number(level.into),
                  span: number(level.span),
                  next: number(level.level + 1),
                })}
              </span>
            </dd>
          </div>
        )}
        {facts.map(({ label, value }) => (
          <div class="grid gap-1 rounded-2xl border border-border bg-surface p-4">
            <dt class="text-sm text-muted">{label}</dt>
            <dd class="text-lg font-semibold">{value}</dd>
          </div>
        ))}
      </dl>
      {profile.bio && (
        <p class="rounded-2xl border border-border bg-surface p-4 break-words whitespace-pre-line">
          {profile.bio}
        </p>
      )}
      {history === null && <p class="text-muted">{t("profile:historyUnavailable")}</p>}
      {achievements.length > 0 && (
        <section
          class="grid gap-3"
          aria-labelledby="achievements-heading"
          data-achievements
          data-profile-id={profile.id}
          data-pins={JSON.stringify(showcase.map((a) => a.key))}
          data-pin-label={t("profile:achievements.pin")}
          data-unpin-label={t("profile:achievements.unpin")}
          data-full={t("profile:achievements.full")}
          data-failed={t("profile:achievements.failed")}
        >
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <h2 id="achievements-heading" class="text-2xl">
              {t("profile:achievements.heading")}
            </h2>
            <span class="text-sm text-muted">
              {t("profile:achievements.unlocked", { count: achievements.length })}
            </span>
          </div>
          {showcase.length > 0 && (
            <>
              <h3 class="text-lg font-semibold">{t("profile:achievements.showcase")}</h3>
              <ul class="grid gap-3 sm:grid-cols-3">
                {showcase.map((a, i) => (
                  <AchievementCard achievement={a} nameId={`showcase-${String(i)}`} />
                ))}
              </ul>
            </>
          )}
          <ul class="grid gap-3 sm:grid-cols-2">
            {achievements.map((a, i) => (
              <AchievementCard achievement={a} nameId={`achievement-${String(i)}`} pinnable />
            ))}
          </ul>
          <p data-pin-message role="status" class="text-sm text-danger empty:hidden" />
        </section>
      )}
      {totals.length > 0 && (
        <section class="grid gap-3" aria-labelledby="stats-heading">
          <h2 id="stats-heading" class="text-2xl">
            {t("profile:stats.heading")}
          </h2>
          <dl class="grid grid-cols-2 gap-3 sm:grid-cols-4">
            {totals.map(({ label, value }) => (
              <div class="grid content-start gap-1 rounded-2xl border border-border bg-surface p-4">
                <dt class="text-sm text-muted">{label}</dt>
                <dd class="text-lg font-semibold break-words">{value}</dd>
              </div>
            ))}
          </dl>
          <ul class="grid gap-3 sm:grid-cols-2">
            {gameStats.map((game) => (
              <li class="grid content-start gap-3 rounded-2xl border border-border bg-surface p-4">
                <h3 class="text-lg font-semibold">{game.name}</h3>
                <dl class="grid grid-cols-2 gap-x-4 gap-y-2 text-sm">
                  {game.facts.map(({ label, value }) => (
                    <div class="grid">
                      <dt class="text-muted">{label}</dt>
                      <dd class="font-semibold tabular-nums">{value}</dd>
                    </div>
                  ))}
                </dl>
              </li>
            ))}
          </ul>
        </section>
      )}
      {history && history.ratings.length > 0 && (
        <section class="grid gap-3" aria-labelledby="ratings-heading">
          <h2 id="ratings-heading" class="text-2xl">
            {t("profile:ratings")}
          </h2>
          <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3">
            {history.ratings.map((rating) => (
              <li class="grid gap-1 rounded-2xl border border-border bg-surface p-4">
                <span class="text-sm text-muted">
                  {gameName(rating.gameId, locale)} · {poolName(t, rating.pool)}
                </span>
                <span class="text-2xl font-semibold tabular-nums">
                  {number(rating.rating)}
                  {rating.games < PROVISIONAL_GAMES && (
                    <>
                      <span aria-hidden="true" title={t("profile:provisional")}>
                        ?
                      </span>
                      <span class="sr-only">{t("profile:provisional")}</span>
                    </>
                  )}
                </span>
                <span class="text-sm text-muted">
                  {t("profile:ratingGames", { count: number(rating.games) })}
                </span>
              </li>
            ))}
          </ul>
        </section>
      )}
      {history && history.ratingHistory.length > 0 && (
        <section class="grid gap-3" aria-labelledby="rating-history-heading">
          <h2 id="rating-history-heading" class="text-2xl">
            {t("profile:chart.heading")}
          </h2>
          <div class="grid gap-3 md:grid-cols-2">
            {history.ratingHistory
              .toSorted((a, b) => b.points.length - a.points.length)
              .map((series) => (
                <RatingHistoryChart
                  series={series}
                  title={`${gameName(series.gameId, locale)} · ${poolName(t, series.pool)}`}
                  bcp47={bcp47}
                  strings={chartStrings}
                />
              ))}
          </div>
        </section>
      )}
      {history && (
        <section class="grid gap-3" aria-labelledby="games-heading">
          <h2 id="games-heading" class="text-2xl">
            {t("profile:recentGames")}
          </h2>
          {games.length === 0 ? (
            <p class="text-muted">{t("profile:noGames")}</p>
          ) : (
            <ol class="grid gap-2">
              {games.map((game) => (
                <li>
                  <a
                    href={game.href}
                    class="flex items-center gap-3 rounded-2xl border border-border bg-surface p-3 hover:bg-surface-2"
                  >
                    {game.badge && (
                      <span
                        class={`shrink-0 rounded-full px-2.5 py-0.5 text-sm font-semibold ${OUTCOME_CLASS[game.outcome ?? "draw"]}`}
                      >
                        {game.badge}
                      </span>
                    )}
                    <span class="grid min-w-0 flex-1">
                      <span class="truncate font-semibold">{game.title}</span>
                      <span class="truncate text-sm text-muted">{game.detail}</span>
                    </span>
                    {game.change && (
                      <span class="shrink-0 font-semibold tabular-nums">{game.change}</span>
                    )}
                  </a>
                </li>
              ))}
            </ol>
          )}
        </section>
      )}
    </article>
  </AppShell>
)}

<script>
  import "@/features/profile/achievement-pins.client";
  import "@/features/friends/profile-actions.client";
  import "@/features/live/profile-presence.client";
</script>
