---
import { getRelativeLocaleUrl } from "astro:i18n";
import { Inbox, RefreshCw, TriangleAlert } from "lucide-react";

import { UserAvatar } from "@kefche/ui/components/avatar";
import { Badge } from "@kefche/ui/components/badge";
import { Button } from "@kefche/ui/components/button";
import {
  Card,
  CardContent,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
} from "@kefche/ui/components/card";
import { Input } from "@kefche/ui/components/input";
import { PlayerMarker, type PlayerSlot } from "@kefche/ui/components/player-marker";
import { Skeleton } from "@kefche/ui/components/skeleton";
import { EmptyState, ErrorState } from "@kefche/ui/components/states";

import Logo from "@/components/Logo.astro";
import { DevInteractive } from "@/features/dev/DevInteractive";
import AppShell from "@/features/shell/AppShell.astro";
import { getT } from "@/i18n/i18n";
import { LOCALE_INFO, LOCALES, type Locale } from "@/i18n/locales";

import type { GetStaticPaths } from "astro";

// Dev-only component gallery (Phase 1 DoD): generated by `astro dev`, never
// by production builds. Sample copy is English fixture text.
export const getStaticPaths = (() =>
  import.meta.env.DEV
    ? LOCALES.map((locale) => ({ params: { locale } }))
    : []) satisfies GetStaticPaths;

const locale = Astro.params.locale as Locale;
const t = getT(locale);
const { dir } = LOCALE_INFO[locale];

const surfaces = ["bg", "surface", "surface-2", "border", "border-strong"] as const;
const swatchClass: Record<(typeof surfaces)[number], string> = {
  bg: "bg-bg",
  surface: "bg-surface",
  "surface-2": "bg-surface-2",
  border: "bg-border",
  "border-strong": "bg-border-strong",
};
const semantic = [
  ["brand", "bg-brand text-on-brand"],
  ["brand-2", "bg-brand-2 text-on-brand-2"],
  ["accent", "bg-accent text-on-accent"],
  ["danger", "bg-danger text-on-danger"],
] as const;
const text = [
  ["text", "text-text"],
  ["muted", "text-muted"],
  ["brand-strong", "text-brand-strong"],
  ["link", "text-link"],
  ["success", "text-success"],
  ["warning", "text-warning"],
  ["info", "text-info"],
] as const;
const players: PlayerSlot[] = [1, 2, 3, 4, 5, 6, 7, 8];
const categories = [
  ["board", "bg-cat-board text-cat-board-ink"],
  ["cards", "bg-cat-cards text-cat-cards-ink"],
  ["logic", "bg-cat-logic text-cat-logic-ink"],
  ["arcade", "bg-cat-arcade text-cat-arcade-ink"],
  ["arenas", "bg-cat-arenas text-cat-arenas-ink"],
  ["party", "bg-cat-party text-cat-party-ink"],
  ["word", "bg-cat-word text-cat-word-ink"],
  ["speed", "bg-cat-speed text-cat-speed-ink"],
  ["strategy", "bg-cat-strategy text-cat-strategy-ink"],
  ["sports", "bg-cat-sports text-cat-sports-ink"],
] as const;
const people = [
  ["Mila", "u-1"],
  ["Георги", "u-2"],
  ["李小龙", "u-3"],
  ["élodie_42", "u-4"],
  ["Ахмед", "u-5"],
] as const;
const sectionClass = "grid gap-4";
const h2Class = "text-2xl";
---

<AppShell
  locale={locale}
  path="/dev/ui/"
  title="UI gallery · kefche (dev)"
  description="Development component gallery."
  noindex
>
  <div class="grid max-w-5xl gap-12">
    <header class="grid gap-3">
      <h1 class="text-4xl">UI gallery</h1>
      <p class="max-w-prose text-muted">
        Every Phase 1 component. Switch theme in the header; check RTL in{" "}
        <a class="text-link underline" href={getRelativeLocaleUrl("ar", "/dev/ui/")}>
          Arabic
        </a>
        . Current locale: <strong>{LOCALE_INFO[locale].nativeName}</strong> ({dir}).
      </p>
    </header>

    <section class={sectionClass} aria-labelledby="brand">
      <h2 id="brand" class={h2Class}>
        Brand
      </h2>
      <div class="flex flex-wrap items-center gap-6">
        <Logo class="w-56" />
        <Logo variant="icon" class="w-16" />
        <Logo variant="icon" class="w-8" />
      </div>
    </section>

    <section class={sectionClass} aria-labelledby="colors">
      <h2 id="colors" class={h2Class}>
        Color tokens
      </h2>
      <ul class="flex flex-wrap gap-3">
        {surfaces.map((s) => (
          <li class="grid w-28 gap-1 text-sm">
            <span class:list={["h-14 rounded-xl border border-border", swatchClass[s]]} />
            <code>--{s}</code>
          </li>
        ))}
      </ul>
      <ul class="flex flex-wrap gap-3">
        {semantic.map(([name, cls]) => (
          <li class:list={["rounded-xl px-4 py-3 font-semibold", cls]}>{name}</li>
        ))}
      </ul>
      <ul class="flex flex-wrap gap-4 rounded-xl bg-surface p-4">
        {text.map(([name, cls]) => (
          <li class:list={["font-semibold", cls]}>{name}</li>
        ))}
      </ul>
    </section>

    <section class={sectionClass} aria-labelledby="players">
      <h2 id="players" class={h2Class}>
        Players and categories
      </h2>
      <ul class="flex flex-wrap gap-3">
        {players.map((p) => (
          <li class="flex items-center gap-2 rounded-xl bg-surface px-3 py-2">
            <PlayerMarker player={p} />
            <span>Player {p}</span>
          </li>
        ))}
      </ul>
      <ul class="flex flex-wrap gap-2">
        {categories.map(([name, cls]) => (
          <li class:list={["rounded-full px-3 py-1 text-sm font-semibold", cls]}>{name}</li>
        ))}
      </ul>
    </section>

    <section class={sectionClass} aria-labelledby="type">
      <h2 id="type" class={h2Class}>
        Typography
      </h2>
      <div class="grid gap-2">
        <p class="font-display text-5xl">Играй с приятели</p>
        <p class="font-display text-3xl">Play with friends</p>
        <p class="text-xl">Δωρεάν παιχνίδια · 1–4 players · 12:05</p>
        <p class="text-base">Body text at 1rem: the quick brown fox jumps over the lazy dog.</p>
        <p class="text-sm text-muted">Small muted text for captions and metadata.</p>
      </div>
    </section>

    <section class={sectionClass} aria-labelledby="buttons">
      <h2 id="buttons" class={h2Class}>
        Buttons and badges
      </h2>
      <div class="flex flex-wrap items-center gap-3">
        <Button>Play now</Button>
        <Button variant="secondary">Create lobby</Button>
        <Button variant="outline">Join with code</Button>
        <Button variant="ghost">Rules</Button>
        <Button variant="danger">Resign</Button>
        <Button variant="link">How to play</Button>
        <Button size="lg">Quick match</Button>
        <Button size="icon" aria-label="Refresh">
          <RefreshCw aria-hidden="true" />
        </Button>
        <Button disabled>Disabled</Button>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <Badge>1–4</Badge>
        <Badge variant="brand">Featured</Badge>
        <Badge variant="accent">Online</Badge>
        <Badge variant="danger">Live</Badge>
        <Badge variant="new">{t("common:comingSoon.badge")}</Badge>
        <Badge variant="new">New</Badge>
        <Badge variant="hot">Hot</Badge>
      </div>
    </section>

    <section class={sectionClass} aria-labelledby="forms">
      <h2 id="forms" class={h2Class}>
        Inputs, cards and avatars
      </h2>
      <div class="grid max-w-md gap-2">
        <label for="dev-nickname" class="font-semibold">
          Nickname
        </label>
        <Input id="dev-nickname" placeholder="3–20 characters" />
        <label for="dev-code" class="font-semibold">
          Room code
        </label>
        <Input
          id="dev-code"
          defaultValue="KF9"
          aria-invalid="true"
          aria-describedby="dev-code-error"
        />
        <p id="dev-code-error" class="text-sm text-danger">
          Room codes have 6 characters.
        </p>
      </div>
      <div class="grid gap-4 md:grid-cols-2">
        <Card>
          <CardHeader>
            <CardTitle>Four in a Row</CardTitle>
            <CardDescription>2–4 players · 5–10 min</CardDescription>
          </CardHeader>
          <CardContent>
            <p>Drop discs, connect four in a line before your opponents do.</p>
          </CardContent>
          <CardFooter>
            <Button>Play</Button>
            <Badge variant="new">New</Badge>
          </CardFooter>
        </Card>
        <Card aria-busy="true">
          <CardHeader>
            <Skeleton className="h-6 w-2/3" />
            <Skeleton className="h-4 w-1/3" />
          </CardHeader>
          <Skeleton className="h-16 w-full" />
          <span class="sr-only">Loading</span>
        </Card>
      </div>
      <ul class="flex flex-wrap items-center gap-3">
        {people.map(([name, id], i) => (
          <li>
            <UserAvatar name={name} id={id} size={i === 0 ? "xl" : i === 1 ? "lg" : "md"} />
          </li>
        ))}
      </ul>
    </section>

    <section class={sectionClass} aria-labelledby="states">
      <h2 id="states" class={h2Class}>
        Empty and error states
      </h2>
      <div class="grid gap-4 md:grid-cols-2">
        <EmptyState
          title="No friends yet"
          description="Invite someone with a link, or add a player from a match."
        >
          <Inbox slot="icon" />
        </EmptyState>
        <ErrorState
          title="Couldn't load the leaderboard"
          description="Check your connection and try again."
        >
          <TriangleAlert slot="icon" />
        </ErrorState>
      </div>
    </section>

    <section class={sectionClass} aria-labelledby="interactive">
      <h2 id="interactive" class={h2Class}>
        Dialog, sheet, tabs and toast
      </h2>
      <DevInteractive
        client:load
        dir={dir}
        closeLabel={t("common:actions.close")}
        notificationsLabel={t("common:notifications.label")}
      />
    </section>
  </div>
</AppShell>
