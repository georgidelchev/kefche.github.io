---
import { getRelativeLocaleUrl } from "astro:i18n";

import AuthLayout from "@/features/auth/AuthLayout.astro";
import { authStaticPaths, monthNames } from "@/features/auth/page-helpers";
import { authPaths } from "@/features/auth/paths";
import { SignUpForm } from "@/features/auth/SignUpForm";
import { authStrings } from "@/features/auth/strings";
import { getT } from "@/i18n/i18n";
import type { Locale } from "@/i18n/locales";

export const getStaticPaths = authStaticPaths;

const locale = Astro.params.locale as Locale;
const t = getT(locale);
---

<AuthLayout
  locale={locale}
  path="/auth/sign-up/"
  heading={t("auth:signUp.title")}
  description={t("auth:signUp.description")}
>
  <SignUpForm
    client:load
    strings={authStrings(t)}
    paths={authPaths(locale, getRelativeLocaleUrl)}
    locale={locale}
    monthNames={monthNames(locale)}
  />
</AuthLayout>
