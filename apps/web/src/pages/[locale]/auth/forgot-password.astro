---
import { getRelativeLocaleUrl } from "astro:i18n";

import AuthLayout from "@/features/auth/AuthLayout.astro";
import { ForgotPasswordForm } from "@/features/auth/ForgotPasswordForm";
import { authStaticPaths } from "@/features/auth/page-helpers";
import { authPaths } from "@/features/auth/paths";
import { authStrings } from "@/features/auth/strings";
import { getT } from "@/i18n/i18n";
import type { Locale } from "@/i18n/locales";

export const getStaticPaths = authStaticPaths;

const locale = Astro.params.locale as Locale;
const t = getT(locale);
---

<AuthLayout
  locale={locale}
  path="/auth/forgot-password/"
  heading={t("auth:forgot.title")}
  description={t("auth:forgot.description")}
>
  <ForgotPasswordForm
    client:load
    strings={authStrings(t)}
    paths={authPaths(locale, getRelativeLocaleUrl)}
  />
</AuthLayout>
