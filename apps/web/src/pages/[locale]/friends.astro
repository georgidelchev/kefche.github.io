---
import { getRelativeLocaleUrl } from "astro:i18n";

import { authStaticPaths } from "@/features/auth/page-helpers";
import { authPaths } from "@/features/auth/paths";
import { FriendsPage } from "@/features/friends/FriendsPage";
import { friendsPageStrings } from "@/features/friends/strings";
import { gameNames, roomGames } from "@/features/games/game-names";
import AppShell from "@/features/shell/AppShell.astro";
import { getT } from "@/i18n/i18n";
import { LOCALE_INFO, type Locale } from "@/i18n/locales";

// Friends (SPEC §8.1): private and noindex; only in builds with accounts.
// The island reads the signed-in player's lists and sends visitors to sign in.
export const getStaticPaths = authStaticPaths;

const locale = Astro.params.locale as Locale;
const t = getT(locale);
const { bcp47, dir } = LOCALE_INFO[locale];
const paths = authPaths(locale, getRelativeLocaleUrl);
const title = t("friends:title");
---

<AppShell
  locale={locale}
  path="/friends/"
  title={t("common:meta.sectionTitle", { section: title })}
  description={t("friends:description")}
  noindex
>
  <div class="mx-auto grid w-full max-w-2xl gap-6 pb-6">
    <header class="grid gap-2">
      <h1 class="text-3xl md:text-4xl">{title}</h1>
      <p class="text-muted">{t("friends:description")}</p>
    </header>
    <FriendsPage
      client:load
      strings={friendsPageStrings(t)}
      bcp47={bcp47}
      dir={dir}
      signInPath={paths.signIn}
      profileBase={getRelativeLocaleUrl(locale, "/u/")}
      gameNames={gameNames(locale)}
      games={roomGames(locale)}
      playBase={getRelativeLocaleUrl(locale, "/play/")}
    />
  </div>
</AppShell>
