---
import Logo from "@/components/Logo.astro";
import AppShell from "@/features/shell/AppShell.astro";
import { getT } from "@/i18n/i18n";
import { LOCALES, type Locale } from "@/i18n/locales";

import type { GetStaticPaths } from "astro";

export const getStaticPaths = (() =>
  LOCALES.map((locale) => ({ params: { locale } }))) satisfies GetStaticPaths;

const locale = Astro.params.locale as Locale;
const t = getT(locale);
---

<AppShell
  locale={locale}
  path="/"
  section="home"
  title={t("common:meta.title")}
  description={t("common:meta.description")}
>
  <section class="grid max-w-2xl gap-4 py-8 md:py-16">
    <h1>
      <Logo class="w-64 max-w-full md:w-80" />
    </h1>
    <p class="text-lg text-muted md:text-xl">{t("common:hero.tagline")}</p>
  </section>
</AppShell>
