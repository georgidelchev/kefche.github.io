---
import { WifiOff } from "lucide-react";

import { buttonVariants } from "@kefche/ui/components/button";

import AppShell from "@/features/shell/AppShell.astro";
import { getT } from "@/i18n/i18n";
import { LOCALES, type Locale } from "@/i18n/locales";

import type { GetStaticPaths } from "astro";

// Shown by the service worker when a page isn't cached and the network is
// down (wired up in Phase 16). Also reachable directly, so it's noindex.
export const getStaticPaths = (() =>
  LOCALES.map((locale) => ({ params: { locale } }))) satisfies GetStaticPaths;

const locale = Astro.params.locale as Locale;
const t = getT(locale);
const title = t("errors:offline.title");
---

<AppShell
  locale={locale}
  path="/offline/"
  title={t("common:meta.sectionTitle", { section: title })}
  description={t("errors:offline.body")}
  noindex
>
  <section class="mx-auto grid max-w-xl justify-items-center gap-4 py-12 text-center md:py-20">
    <div
      aria-hidden="true"
      class="flex size-16 items-center justify-center rounded-2xl bg-surface-2 text-muted"
    >
      <WifiOff className="size-8" />
    </div>
    <h1 class="text-3xl md:text-4xl">{title}</h1>
    <p class="text-lg text-muted">{t("errors:offline.body")}</p>
    <button type="button" data-retry class:list={[buttonVariants({ variant: "primary" }), "mt-2"]}>
      {t("errors:offline.retry")}
    </button>
  </section>
</AppShell>

<script>
  for (const button of document.querySelectorAll("button[data-retry]")) {
    button.addEventListener("click", () => {
      location.reload();
    });
  }
</script>
