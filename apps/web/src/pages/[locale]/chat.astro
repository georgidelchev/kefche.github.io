---
import { getRelativeLocaleUrl } from "astro:i18n";

import { authStaticPaths } from "@/features/auth/page-helpers";
import { authPaths } from "@/features/auth/paths";
import { ChatPage } from "@/features/chat/ChatPage";
import { chatPageStrings, chatToolsStrings } from "@/features/chat/strings";
import SocialNav from "@/features/friends/SocialNav.astro";
import AppShell from "@/features/shell/AppShell.astro";
import { getT } from "@/i18n/i18n";
import { LOCALE_INFO, LOCALES, type Locale } from "@/i18n/locales";
import { GIFS_ENABLED } from "@/lib/gifs";

// Global chat (SPEC §8.2): private and noindex; only in builds with
// accounts. Guests and visitors are sent to sign in.
export const getStaticPaths = authStaticPaths;

const locale = Astro.params.locale as Locale;
const t = getT(locale);
const { bcp47, dir } = LOCALE_INFO[locale];
const paths = authPaths(locale, getRelativeLocaleUrl);
const title = t("chat:title");
---

<AppShell
  locale={locale}
  path="/chat/"
  section="friends"
  title={t("common:meta.sectionTitle", { section: title })}
  description={t("chat:description")}
  noindex
>
  <div class="mx-auto grid w-full max-w-3xl gap-6 pb-6">
    <SocialNav locale={locale} current="chat" />
    <header class="grid gap-2">
      <h1 class="text-3xl md:text-4xl">{title}</h1>
      <p class="text-muted">{t("chat:description")}</p>
    </header>
    <ChatPage
      client:load
      strings={chatPageStrings(t)}
      rooms={LOCALES.map((code) => ({ code, name: LOCALE_INFO[code].nativeName }))}
      initialRoom={locale}
      bcp47={bcp47}
      signInPath={paths.signIn}
      profileBase={getRelativeLocaleUrl(locale, "/u/")}
      tools={chatToolsStrings(t, locale)}
      gifs={GIFS_ENABLED}
      dir={dir}
    />
  </div>
</AppShell>
