---
import { getRelativeLocaleUrl } from "astro:i18n";
import { SearchX } from "lucide-react";

import JsonLd from "@/components/JsonLd.astro";
import { sortByName } from "@/features/games/catalog";
import CategoryNav from "@/features/games/CategoryNav.astro";
import GameCard from "@/features/games/GameCard.astro";
import { listGames } from "@/features/games/registry";
import AppShell from "@/features/shell/AppShell.astro";
import { getT } from "@/i18n/i18n";
import { LOCALE_INFO, LOCALES, type Locale } from "@/i18n/locales";

import type { GetStaticPaths } from "astro";

// The games catalog (SPEC §6.6): every game, A–Z, with category chips and a
// search over localized names. The header search lands here with ?q=.
export const getStaticPaths = (() =>
  LOCALES.map((locale) => ({ params: { locale } }))) satisfies GetStaticPaths;

const locale = Astro.params.locale as Locale;
const t = getT(locale);
const { bcp47 } = LOCALE_INFO[locale];
const games = sortByName(listGames(), locale, bcp47);
const url = (p: string) => new URL(getRelativeLocaleUrl(locale, p), Astro.site).href;

// Pre-rendered result counts (ICU plurals stay on the server) and the
// "no match" template; the script below picks from them.
const resultLabels = Array.from({ length: games.length + 1 }, (_, count) =>
  t("games:catalog.results", { count }),
);
const noMatch = t("games:catalog.noMatch", { query: "{query}" });

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: t("nav:games"),
  description: t("games:catalog.description"),
  url: url("/games/"),
  inLanguage: bcp47,
  mainEntity: {
    "@type": "ItemList",
    itemListElement: games.map((game, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: game.text[locale].name,
      url: url(`/games/${game.manifest.id}/`),
    })),
  },
};
---

<AppShell
  locale={locale}
  path="/games/"
  section="games"
  title={t("common:meta.sectionTitle", { section: t("nav:games") })}
  description={t("games:catalog.description")}
>
  <div class="mx-auto grid w-full max-w-7xl gap-6 pb-6">
    <header class="grid gap-2">
      <h1 class="text-4xl md:text-5xl">{t("nav:games")}</h1>
      <p class="max-w-prose text-lg text-muted">{t("games:catalog.intro")}</p>
    </header>

    <form role="search" method="get" class="max-w-md" data-catalog-search>
      <label for="catalog-search" class="mb-1 block text-sm font-semibold">
        {t("games:catalog.search")}
      </label>
      <input
        id="catalog-search"
        name="q"
        type="search"
        autocomplete="off"
        enterkeyhint="search"
        placeholder={t("games:catalog.searchPlaceholder")}
        class="min-h-11 w-full rounded-xl border border-border-strong bg-surface-2 px-3 text-base text-text placeholder:text-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
      />
    </form>

    <CategoryNav locale={locale} />

    <p
      role="status"
      class="text-sm font-semibold text-muted"
      data-results
      data-labels={JSON.stringify(resultLabels)}
    >
      {resultLabels[games.length]}
    </p>

    <ul
      class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:gap-4 lg:grid-cols-4 xl:grid-cols-5"
      data-game-list
    >
      {games.map((game) => (
        <GameCard locale={locale} game={game} />
      ))}
    </ul>

    <div
      hidden
      data-no-match
      class="flex flex-col items-center gap-3 rounded-2xl border border-dashed border-border p-8 text-center"
    >
      <div
        aria-hidden="true"
        class="flex size-14 items-center justify-center rounded-full bg-surface-2 text-muted"
      >
        <SearchX className="size-7" />
      </div>
      <p class="text-lg font-semibold text-balance" data-no-match-title data-template={noMatch}></p>
      <p class="max-w-prose text-muted">{t("games:catalog.noMatchHint")}</p>
      <button
        type="button"
        data-clear
        class="mt-2 min-h-11 rounded-xl border border-border-strong bg-surface px-4 font-semibold hover:bg-surface-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
      >
        {t("games:catalog.clear")}
      </button>
    </div>
  </div>
  <JsonLd data={jsonLd} />
</AppShell>

<script>
  // Filters the pre-rendered cards as you type. Without JavaScript every game
  // stays listed. The query is kept in ?q= so results can be shared.
  const form = document.querySelector<HTMLFormElement>("[data-catalog-search]");
  const input = document.querySelector<HTMLInputElement>("#catalog-search");
  const status = document.querySelector<HTMLElement>("[data-results]");
  const empty = document.querySelector<HTMLElement>("[data-no-match]");
  const emptyTitle = document.querySelector<HTMLElement>("[data-no-match-title]");
  const clear = document.querySelector<HTMLButtonElement>("[data-clear]");
  const cards = [...document.querySelectorAll<HTMLElement>("[data-game]")];

  if (form && input && status && empty && emptyTitle && clear) {
    const labels: unknown = JSON.parse(status.dataset.labels ?? "[]");
    const label = (count: number) =>
      Array.isArray(labels) && typeof labels[count] === "string" ? labels[count] : "";
    const normalize = (value: string) =>
      value.normalize("NFD").replace(/\p{M}/gu, "").toLocaleLowerCase();

    const apply = (query: string) => {
      const words = normalize(query).split(/\s+/).filter(Boolean);
      let shown = 0;
      for (const card of cards) {
        const match = words.every((word) => (card.dataset.search ?? "").includes(word));
        card.hidden = !match;
        if (match) shown += 1;
      }
      status.textContent = label(shown);
      empty.hidden = shown > 0;
      emptyTitle.textContent = (emptyTitle.dataset.template ?? "").replace("{query}", query.trim());
      const url = new URL(location.href);
      if (query.trim()) url.searchParams.set("q", query.trim());
      else url.searchParams.delete("q");
      history.replaceState(history.state, "", url);
    };

    const initial = new URLSearchParams(location.search).get("q") ?? "";
    if (initial) {
      input.value = initial;
      apply(initial);
    }
    input.addEventListener("input", () => {
      apply(input.value);
    });
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      apply(input.value);
    });
    clear.addEventListener("click", () => {
      input.value = "";
      apply("");
      input.focus();
    });
  }
</script>
