---
import { ACCOUNT_STORAGE_KEY } from "@/features/account/account-summary";
import { FLAGS_STORAGE_KEY } from "@/features/flags/flags";
import { RAIL_STORAGE_KEY } from "@/features/shell/rail";
import { THEME_STORAGE_KEY } from "@/features/theme/theme";

// Runs before first paint, so stored UI preferences never flash (SPEC §6.3).
// Must stay tiny and dependency-free; only exact known values are accepted.
// Phase 17: this inline script needs a CSP hash.
---

<script
  is:inline
  define:vars={{
    themeKey: THEME_STORAGE_KEY,
    railKey: RAIL_STORAGE_KEY,
    accountKey: ACCOUNT_STORAGE_KEY,
    flagsKey: FLAGS_STORAGE_KEY,
  }}
>
  try {
    const root = document.documentElement;
    const theme = localStorage.getItem(themeKey);
    if (theme === "light" || theme === "dark") root.dataset.theme = theme;
    if (localStorage.getItem(railKey) === "compact") root.dataset.rail = "compact";
    // Only a hint for the header; account.client.ts validates the summary.
    const account = localStorage.getItem(accountKey);
    if (account) {
      root.dataset.account = "signed-in";
      if (JSON.parse(account).staff === true) root.dataset.staff = "true";
    }
    // Features an admin turned off, as last seen (flags.client.ts checks again).
    const flagsOff = localStorage.getItem(flagsKey);
    if (flagsOff && /^[a-z_]+( [a-z_]+)*$/.test(flagsOff)) root.dataset.flagsOff = flagsOff;
  } catch {
    // Storage unavailable: defaults apply.
  }
</script>
