# â”€â”€ Supabase (browser) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Project API URL. Local: printed by `pnpm db:start` (default http://127.0.0.1:54321).
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key (sb_publishable_â€¦), safe to expose; RLS protects data.
# Local: printed by `pnpm db:start` / `pnpm supabase status`.
# Never put a secret key (sb_secret_â€¦) here: PUBLIC_* values are bundled into client JS.
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
