# kefche environment variables.
# Copy to .env.local in this folder (git-ignored) and fill in. Never commit real values.
# Every variable used anywhere must be documented here.

# --- Supabase (browser) ------------------------------------------------------
# Optional as a pair: leave both empty and the site builds without account
# features (ADR-0011). Setting only one, or an invalid value, fails the build.
#
# Project API URL. Local: printed by `pnpm db:start` (default http://127.0.0.1:54321).
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key (sb_publishable_...), safe to expose; RLS protects data.
# Local: printed by `pnpm db:start` / `pnpm db:status`.
# Never put a secret key (sb_secret_...) here: PUBLIC_* values are bundled into client JS.
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Sign-in providers (browser) ---------------------------------------------
# OAuth buttons to show: a comma-separated list of google, discord, twitch,
# facebook, or "none". Leave unset for all four (local development, with the
# dev apps from docs/RUNBOOK.md). Production uses "none" until its OAuth apps
# exist (Phase 21).
# PUBLIC_AUTH_PROVIDERS=none

# --- GIFs (browser) ------------------------------------------------------------
# "on" shows the GIF button in global chat and DMs. Set it only once the giphy
# Edge Function has its GIPHY_API_KEY secret (docs/RUNBOOK.md); off by default.
# PUBLIC_GIFS=on

# --- Notifications (browser) ---------------------------------------------------
# The public VAPID key for Web Push (the base64url half of the pair; the private
# half is the send-push function's VAPID_PRIVATE_KEY secret, docs/RUNBOOK.md,
# "Web Push"). Without it, settings don't offer push.
# PUBLIC_VAPID_PUBLIC_KEY=
# "on" shows the email column in the notification settings. Set it only once
# Resend sends the email outbox (Phase 21); off by default.
# PUBLIC_EMAIL_NOTIFICATIONS=on
