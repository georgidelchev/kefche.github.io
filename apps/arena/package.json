{
  "name": "arena",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Real-time arena server: a Cloudflare Worker with one Durable Object per arena (Phase 9).",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc -p .",
    "cf:deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261029.1",
    "@kefche/config": "workspace:*",
    "typescript": "6.0.3",
    "wrangler": "4.151.3"
  },
  "dependencies": {
    "@kefche/game-backgammon": "workspace:*",
    "@kefche/game-belote": "workspace:*",
    "@kefche/game-crazy-colors": "workspace:*",
    "@kefche/game-durak": "workspace:*",
    "@kefche/game-gin-rummy": "workspace:*",
    "@kefche/game-hearts": "workspace:*",
    "@kefche/game-liars-dice": "workspace:*",
    "@kefche/game-ludo": "workspace:*",
    "@kefche/game-santase": "workspace:*",
    "@kefche/game-sdk": "workspace:*",
    "@kefche/game-sea-battle": "workspace:*",
    "@kefche/game-spades": "workspace:*",
    "@kefche/game-war": "workspace:*",
    "@kefche/game-worm-rush": "workspace:*",
    "zod": "4.6.7"
  }
}
