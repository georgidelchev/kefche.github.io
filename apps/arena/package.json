    "cf:deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261029.1",
    "@kefche/config": "workspace:*",
    "typescript": "6.0.3",
    "wrangler": "4.151.3"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
